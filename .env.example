# ============================================================
# ORNEK ORTAM DEGISKENLERI
# Bu dosyayi .env olarak kopyala ve gercek degerleri yaz.
# .env dosyasini ASLA git'e commit etme!
# ============================================================

# --- Flask ---
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_APP=app.py

# --- Guvenlik ---
# En az 48 karakter. Uretmek icin PowerShell'de:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir_bunu_48_karakterlik_rastgele_string_yap

# Izinli alan adlari (virgulle ayrilmis)
# Ornek: example.com,www.example.com
ALLOWED_HOSTS=

# --- Rate Limiter ---
# Uretimde Redis onerilir. Lokalde memory:// yeterli.
RATELIMIT_STORAGE_URI=memory://

# --- Veritabani ---
# Lokal gelistirme icin SQLite
DB_PATH=egitim.db

# --- Admin (ilk kurulum) ---
ADMIN_TC=11111111111
ADMIN_PASSWORD=degistir_bunu
ADMIN_NAME=Sistem Yoneticisi
